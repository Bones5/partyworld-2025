{
    "stylelint.enable": false,
    "stylelint.validate": ["css", "scss", "less"],
    "stylelint.stylelintPath": "./node_modules/stylelint",
    "editor.codeActionsOnSave": {
        "source.fixAll.stylelint": "never"
    },
    "[scss]": {
        "editor.defaultFormatter": null,
        "editor.codeActionsOnSave": {
            "source.fixAll.stylelint": "never"
        }
    },
    "[css]": {
        "editor.defaultFormatter": null,
        "editor.codeActionsOnSave": {
            "source.fixAll.stylelint": "never"
        }
    }
}
